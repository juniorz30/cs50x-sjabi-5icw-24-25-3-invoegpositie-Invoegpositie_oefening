import cv2 

def detect_faces(image_path): 

 # Laad het vooraf getrainde Haarcascade-model voor gezichtsdetectie 

 face_cascade = cv2.CascadeClassifier(cv2.data.haarcascades + 'haarcascade_frontalface_default.xml') 


 # Laad de afbeelding 

 image = cv2.imread(image_path) 

 gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY) 

  

 # Detecteer gezichten 

 faces = face_cascade.detectMultiScale(gray, scaleFactor=1.1, minNeighbors=5, minSize=(60, 60)) 

 print("face count: ", len(faces))

 # Teken rechthoeken rond de gezichten 
 for (x, y, w, h) in faces: 
     cv2.rectangle(image, (x, y), (x + w, y + h), (255, 200, 0), 2)  # die 3 nullen staan voor DE BGR KLEUREN 
     #en die daar voor zijn coordinaten

 #identation dus opletten op uw spaties

 # Toon de afbeelding met detecties 
 cv2.imshow('Gezichtsdetectie', image) 

 cv2.waitKey(0) 

 cv2.destroyAllWindows()

